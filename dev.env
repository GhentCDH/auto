HOST=0.0.0.0
PORT=8080
BASE_URL=https://auto.example.com
DATABASE_URL=sqlite://data/data.db
KUMA_URL=https://kuma.example.com
KUMA_USERNAME=kuma_username
KUMA_PASSWORD=kuma_password
